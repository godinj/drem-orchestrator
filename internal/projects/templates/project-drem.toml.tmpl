# Generated by `drem project register` — do not edit by hand.
# Regenerate with `drem project register --update {{.ProjectName}}`.
#
# Mounted read-only into the orch container at /var/lib/drem/drem.toml
# (the container's CWD) by project-compose.yml.tmpl. The orchestrator
# binary reads drem.toml from CWD on startup; see cmd/drem/main.go
# LoadConfig.

bare_repo_path = "{{.BareRepoPath}}"
database_path  = "/var/lib/drem/drem.db"
log_path       = "/var/lib/drem/drem.log"

[project]
  language = "{{.Language}}"

# Classifier routes through the warm drem-classifier container on drem-net.
# - `direct=true` bypasses the legacy OpenCode subprocess path (unavailable
#   inside the headless orch container; kept here so the inline-fallback
#   DirectClassifierConfig still gets built).
# - `endpoint` points orch at the warm drem-classifier service. When set,
#   orch POSTs classify jobs to this URL instead of running the LLM call
#   inline — see plans/warm-direct-classifier.md. Unset falls back to the
#   inline direct-SGLang path, which is the rollback-safe default.
# - DREM_CLASSIFIER_URL in the compose env overrides this key.
[agents.classifier]
  direct   = true
  endpoint = "http://drem-classifier:8090/classify"
  model    = "gemma4-26b"

# Endpoint override shared by direct-classifier, direct-prep, and
# direct-tool-agent. The default of http://localhost:8081 resolves to
# orch itself inside the container and therefore fails; gq on drem-net
# forwards to sglang on drem-net.
[direct_tool_agent]
  endpoint = "http://gq:8090/v1/chat/completions"
  model    = "gemma4-26b"

# Planner runs as a long-lived warm drem-planner container (see
# deploy/compose/global.yml) that orch reaches via POST /plan. See
# plans/warm-planner-pivot.md. Provider=claude enables the HTTP path
# in processPlanning; any other value (e.g. sglang-direct) falls back
# to the legacy runner.SpawnAgent path for rollback safety.
#
# Auth is subscription-only: the planner container bind-mounts
# ~/.claude/.credentials.json from the host read-only. Operator must
# have run `claude login` on host before `docker compose up`. NO
# ANTHROPIC_API_KEY passthrough — see plan §1.
#
# The same subscription-only policy covers every claude-backed worker
# (coder/reviewer/fixer/tester/supervisor). Each claude worker gets
# the creds file bind-mounted into its ephemeral container at
# /home/drem/.claude/.credentials.json via the DREM_WORKER_CREDS_PATH
# env var on orch (defined in the compose sibling of this file). One
# `claude login` on host covers the entire agent fleet. See
# plans/worker-subscription-auth.md.
[agents.planner]
  provider = "claude"
  model    = "claude-opus-4-6"
  effort   = "high"
