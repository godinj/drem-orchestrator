+        # Check if Marlin supports the layer's dimensions.
+        # If not (e.g. vision encoder MLP with intermediate_size=4304,
+        # merged gate+up=8608 which is not divisible by 64), we zero-pad
+        # weights to aligned dimensions and truncate output at inference.
+        is_valid, reason = check_marlin_supports_shape(
+            c.partition_weight_shape[1],  # out_features (N)
+            c.partition_weight_shape[0],  # in_features (K)
             c.full_weight_shape[0],  # in_features
             c.group_size,
         )
 
+        self._needs_output_truncation = False
+        self._original_output_size = c.partition_weight_shape[1]
+        self._original_input_size = c.partition_weight_shape[0]
+
+        if not is_valid:
+            orig_n = c.partition_weight_shape[1]
+            orig_k = c.partition_weight_shape[0]
+            aligned_n = self._align_up(orig_n, GPTQ_MARLIN_MIN_THREAD_N)
+            aligned_k = self._align_up(orig_k, GPTQ_MARLIN_MIN_THREAD_K)
+
+            logger.warning_once(
+                "Layer dimensions (N=%d, K=%d) are not compatible with "
+                "Marlin kernels (%s). Zero-padding to (N=%d, K=%d) and "
+                "truncating output at inference.",
+                orig_n, orig_k, reason, aligned_n, aligned_k,
+            )
+
+            pad_n = aligned_n - orig_n
+            pad_k = aligned_k - orig_k
+            pack_factor = self.pack_factor
+
+            # Pad weight_packed: shape is [N, K // pack_factor] (int32)
+            if pad_n > 0 or pad_k > 0:
+                w_q = getattr(layer, self.w_q_name)
+                w_q_data = w_q.data  # [N, K // pack_factor]
+                # Pad K dimension (packed): pad_k must be divisible by
+                # pack_factor since pack_factor=8 and GPTQ_MARLIN_MIN_THREAD_K=128
+                pad_k_packed = pad_k // pack_factor
+                w_q_padded = torch.zeros(
+                    orig_n + pad_n,
+                    w_q_data.shape[1] + pad_k_packed,
+                    dtype=w_q_data.dtype,
+                    device=device,
+                )
+                w_q_padded[:orig_n, :w_q_data.shape[1]] = w_q_data
+                w_q.data = w_q_padded
+
+            # Pad weight_scale: shape is [N, num_groups]
+            w_s = getattr(layer, self.w_s_name)
+            w_s_data = w_s.data
+            orig_groups = w_s_data.shape[1]
+            # If K is padded and group quantization is used, we may need
+            # more scale groups
+            if c.group_size > 0 and pad_k > 0:
+                new_groups = aligned_k // c.group_size
+            else:
+                new_groups = orig_groups
+            pad_groups = new_groups - orig_groups
+            if pad_n > 0 or pad_groups > 0:
+                w_s_padded = torch.ones(
+                    orig_n + pad_n,
+                    orig_groups + pad_groups,
+                    dtype=w_s_data.dtype,
+                    device=device,
+                )
+                w_s_padded[:orig_n, :orig_groups] = w_s_data
+                w_s.data = w_s_padded
+
