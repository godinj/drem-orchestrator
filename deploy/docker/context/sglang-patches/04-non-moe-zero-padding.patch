+                        w_zp_data.shape[0] + pad_n_packed,
+                        orig_groups + pad_groups,
+                        dtype=w_zp_data.dtype,
+                        device=device,
+                    )
+                    w_zp_padded[:w_zp_data.shape[0], :orig_groups] = w_zp_data
