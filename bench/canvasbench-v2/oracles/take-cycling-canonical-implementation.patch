@@ -0,0 +1,35 @@
+// Dedicated audio-take cycling actions. These always target clip-lane versions,
+// even while an automation lane has focus.
+
+void EditorAdapter::takeNext (int /*count*/)
+{
+    cycleSelectedTake (1);
+}
+
+void EditorAdapter::takePrev (int /*count*/)
+{
+    cycleSelectedTake (-1);
+}
+
+void EditorAdapter::cycleSelectedTake (int delta)
+{
+    const int trackIndex = arrangement.getSelectedTrackIndex();
+    if (trackIndex < 0 || trackIndex >= arrangement.getNumTracks())
+        return;
+
+    Track track (arrangement.getTrack (trackIndex));
+    if (track.getType() != TrackType::Audio || track.getClipLaneVersionCount() <= 1)
+        return;
+
+    ScopedTransaction transaction (project.getUndoSystem(), "Cycle Take");
+    if (! TrackVersionService (project).cycle ({ trackIndex }, trackIndex, delta,
+                                                &project.getUndoManager()))
+        return;
+
+    Track updated (arrangement.getTrack (trackIndex));
+    LaneVersion active (updated.getActiveClipLaneVersion());
+    if (onStatusMessage)
+        onStatusMessage ("Take: " + active.getName());
+    if (onContextChanged)
+        onContextChanged();
+}
