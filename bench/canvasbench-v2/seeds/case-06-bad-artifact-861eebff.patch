+static void setupThreeTakeAudioTrack (LvTestFixture& f)
+{
+    f.addTracks (1);
+    f.selectTrack (0);
+    f.focusClipLane();
+
+    dc::Track track (f.project.getTrack (0));
+    track.addClipLaneVersion ("Take 2");
+    track.addClipLaneVersion ("Take 3");
+    REQUIRE (track.getClipLaneVersionCount() == 3);
+}
+
+TEST_CASE ("take.next advances clip-lane version (non-wrap 0->1)", "[integration][take_cycle]")
+{
+    LvTestFixture f;
+    setupThreeTakeAudioTrack (f);
+
+    dc::Track track (f.project.getTrack (0));
+    track.switchClipLaneVersion (0);
+    REQUIRE (track.getActiveClipLaneVersionIndex() == 0);
+
+    f.engine.getActionRegistry().executeAction ("take.next");
+
+    dc::Track trackAfter (f.project.getTrack (0));
+    CHECK (trackAfter.getActiveClipLaneVersionIndex() == 1);
+    CHECK (dc::LaneVersion (trackAfter.getActiveClipLaneVersion()).getName() == "Take 2");
+}
