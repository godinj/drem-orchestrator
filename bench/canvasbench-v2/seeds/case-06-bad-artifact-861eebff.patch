+// ── Take-cycle helper (translation-unit local) ──────────────────────────────
+
+static void cycleSelectedTake (EditorAdapter& adapter, int delta)
+{
+    Arrangement& arrangement = adapter.getArrangement();
+    Project& project = adapter.getProject();
+    VimContext& context = adapter.getContext();
+
+    int trackIdx = arrangement.getSelectedTrackIndex();
+    if (trackIdx < 0 || trackIdx >= arrangement.getNumTracks())
+    {
+        adapter.setStatusMessage ("No selected track");
+        return;
+    }
+
+    Track track (arrangement.getTrack (trackIdx));
+    if (track.getType() != TrackType::Audio)
+    {
+        adapter.setStatusMessage ("Not an audio track");
+        return;
+    }
+
+    int versionCount = track.getClipLaneVersionCount();
+    if (versionCount < 2)
+    {
+        adapter.setStatusMessage ("Track has fewer than two takes");
+        return;
+    }
+
+    // Ignore automation-lane focus — always operate on clip-lane versions
+    ScopedTransaction txn (project.getUndoSystem(), "Cycle Take");
+    bool changed = TrackVersionService (project).cycle (
+        trackVersionTargets (arrangement, context),
+        trackIdx, delta, &project.getUndoManager());
+
+    if (changed)
+    {
+        Track trackAfter (arrangement.getTrack (trackIdx));
+        int activeIdx = trackAfter.getActiveClipLaneVersionIndex();
+        std::string versionName = trackAfter.getClipLaneVersionName (activeIdx);
+        adapter.setStatusMessage ("Take: " + versionName);
+        if (adapter.onContextChanged)
+            adapter.onContextChanged();
+    }
+}
