# Ephemeral per-feature artifacts (orchestrator reads from agent worktrees, stores in DB)
plan.json
CLAUDE.md
# ...except the repo-root CLAUDE.md, which is the project-wide guidance
# file for Claude Code and must be tracked.
!/CLAUDE.md
repo-map.md

# drembench ephemera (regenerable snapshots / per-run scratch)
bench/scratch/
bench/fixtures/real-repo/
bench/results/*.log

# Docker build context artifacts produced by deploy/docker/build-workers.sh
# and deploy/docker/build-csuite.sh. These are regenerable staging copies of
# already-checked-in sources and must not be committed.
deploy/docker/context/drem-watchdog
deploy/docker/context/csuite-persona
deploy/docker/context/dremctl
deploy/docker/context/csuite-proto.sh
deploy/docker/context/csuite-prompts/

# Stray repo-root Go binaries left by `go build` without `-o`. All are
# regenerable: drem-watchdog via deploy/docker/build-workers.sh,
# drem-docker-query-proxy via its Dockerfile multi-stage build,
# drem-classifier via deploy/docker/classifier.Dockerfile,
# drem-planner via deploy/docker/planner.Dockerfile.
/drem-watchdog
/drem-docker-query-proxy
/drem-classifier
/drem-planner
