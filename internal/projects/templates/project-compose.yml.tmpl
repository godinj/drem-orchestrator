# Generated by `drem project register` — do not edit by hand.
# Regenerate with `drem project register --update {{.ProjectName}}`.

version: "3.9"

networks:
  drem-net:
    external: true

volumes:
  drem-{{.ProjectName}}-db:
  drem-{{.ProjectName}}-prompts:
  # csuite-watcher private state (delivery ledger). Named volume keeps
  # watcher-internal SQLite out of the shared /csuite/ tree so a
  # mis-aimed persona write can never corrupt the idempotency key.
  # See plans/csuite-watcher-outbox-routing.md §4.
  drem-{{.ProjectName}}-csuite-watcher-data:
  drem-spawner-sock:
    external: true
    name: drem-spawner-sock

services:
  orch:
    image: {{.OrchImage}}
    environment:
      DREM_HEADLESS: "1"
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_BARE_REPO: "{{.BareRepoPath}}"
      DREM_DB_PATH: "/var/lib/drem/drem.db"
      DREM_ORCH_LISTEN: ":8080"
      DREM_SPAWNER_SOCKET: "/var/run/drem/spawner.sock"
      # Self-URL so dispatchMerge can pass --orch-url to spawned merger
      # containers. Mergers POST merge_result records back to this URL.
      DREM_ORCH_URL: "http://orch:8080"
      DREM_AGENTMON_TOKEN: "{{.SharedToken}}"
      # Warm drem-classifier endpoint — orch POSTs classify jobs here
      # instead of running the direct-SGLang call inline. Matches the
      # endpoint also declared in drem.toml [agents.classifier]; this env
      # var wins when both are set. See plans/warm-direct-classifier.md.
      DREM_CLASSIFIER_URL: "http://drem-classifier:8090/classify"
      # Warm drem-planner endpoint — orch POSTs plan jobs here instead of
      # spawning per-task planner containers. The planner container
      # bind-mounts the operator's Claude subscription credentials and
      # shells out to the claude CLI per request. See
      # plans/warm-planner-pivot.md §§2-4. Subscription-only auth (no
      # API-key env passthrough anywhere in this generated compose).
      DREM_PLANNER_URL: "http://drem-planner:8090/plan"
      # Host path of the operator's Claude subscription credentials
      # file. Orch forwards this into every claude-backed worker spawn
      # as SpawnWorkerParams.CredsMount; the spawner bind-mounts it
      # read-only at /home/drem/.claude/.credentials.json inside the
      # worker. Subscription-only auth — no API-key fallback. See
      # plans/worker-subscription-auth.md §§1, 6.
      DREM_WORKER_CREDS_PATH: "{{.WorkerCredsPath}}"
      # Host directory where orch atomically writes per-task prompt
      # files. The spawner (a separate container) later bind-mounts the
      # individual file read-only into each worker at
      # /home/drem/.drem/prompt.md. The path is host-identical on orch
      # (bind-mount below) so os.WriteFile in orch and os.Stat in
      # spawner see the same bytes. See
      # plans/worker-prompt-delivery.md §§2, 4.
      DREM_PROMPT_ROOT_HOST: "{{.WorkerPromptRoot}}"
    volumes:
      # Host bind-mount for orch state (drem.db + its WAL/shm sidecars
      # and any other per-project state rooted at /var/lib/drem in the
      # container). A bind-mount (rather than the pre-pivot
      # `drem-<project>-db` named volume) lets operators inspect the
      # database directly with sqlite3/du/cp without
      # `docker run --rm -v <vol>:/src alpine cat ...`. The named
      # `drem-<project>-db` volume remains declared in the top-level
      # volumes block so an existing pre-pivot project's state stays
      # reachable for a one-time migration copy-out; see
      # plans/orch-db-host-access-impl.md §Migration runbook.
      - {{.HostDataDir}}:/var/lib/drem:rw
      - drem-{{.ProjectName}}-prompts:/var/lib/drem/prompts
      # Bind-mount the bare repo at its HOST-identical path so DREM_BARE_REPO
      # (which is a host path) resolves inside the container. Mounting at a
      # different target ("/bare") broke `git worktree list` because the repo
      # env var and the mount target disagreed.
      - {{.BareRepoPath}}:{{.BareRepoPath}}:rw
      # Worker prompt root, bind-mounted read-write at its HOST-identical
      # path so orch can write per-task prompt files and the spawner's
      # (separate-container) pre-stat sees the same path orch wrote to.
      # Read-write: orch writes, spawner only reads. See
      # plans/worker-prompt-delivery.md §4.
      - {{.WorkerPromptRoot}}:{{.WorkerPromptRoot}}:rw
      # drem.toml is generated alongside this compose file and mounted into
      # the orch CWD so LoadConfig finds it. Enables direct-classifier and
      # points the direct-tool endpoint at gq on drem-net. Path is absolute
      # because docker compose does not expand ~.
      - {{.ConfigFilePath}}:/var/lib/drem/drem.toml:ro
      - drem-spawner-sock:/var/run/drem:ro{{if .DevMode}}
      - {{.RepoSourcePath}}:/src:ro{{end}}
      # Bug E W3.2 goroutine-dump retrieval:
      # cmd/drem installs a SIGUSR1 handler that writes
      # /tmp/drem-goroutines-<unix_ts>.log inside the container. To read
      # those dumps from the host without `docker cp`, add a bind-mount
      # of the form `- /host/path:/tmp:rw` (omitted from the generated
      # template so `drem project register` stays side-effect-free on
      # the host FS). Operators who want durable access can add the
      # mount to compose.override.yml and point it at a directory they
      # control. See plans/bug-e-orch-load-shedding.md §W3.2.
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.service: orch
    ports:
      - "127.0.0.1:{{.OrchHostPort}}:8080"
    # Bug E W5.1: healthcheck + on-failure restart policy. A wedged orch
    # (e.g. the 2026-04-21 retry-storm incident, or any future pathology
    # W1's load-shedding does not cover) now gets auto-restarted rather
    # than sitting dead until the operator notices. `curl` ships in the
    # runtime image (see deploy/docker/orch.Dockerfile); GET /projects
    # is the cheapest endpoint that touches the DB and returns useful
    # error signal. `restart: on-failure` replaces the previous
    # `unless-stopped` so an orch that crashes on startup does not
    # restart-loop forever — only post-boot failures retry.
    healthcheck:
      test: ["CMD", "curl", "--fail", "http://127.0.0.1:8080/projects"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: on-failure

  agentmon:
    image: localhost:5000/drem-agentmon:latest
    environment:
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_ORCH_URL: "http://orch:8080"
      DREM_AGENTMON_TOKEN: "{{.SharedToken}}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.service: agentmon
    depends_on: [orch]
    restart: unless-stopped

  csuite-watcher:
    image: localhost:5000/drem-csuite-watcher:latest
    environment:
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_ORCH_URL: "http://orch:8080"
      # 12-factor overrides for cmd/csuite-watcher serve. The container has
      # no drem.toml mounted; the binary reads these instead of [serve] keys.
      # Reuses the agentmon shared token so both can authenticate against orch.
      DREM_BEARER_TOKEN: "{{.SharedToken}}"
      DREM_LISTEN_ADDR: ":8090"
      DREM_DB_PATH: "/var/lib/drem/csuite.db"
      # Outbox-routing delivery ledger — SQLite stored under the named
      # volume mounted at /var/lib/watcher below. See
      # plans/csuite-watcher-outbox-routing.md §Failure modes.
      CSUITE_WATCHER_DB_PATH: "/var/lib/watcher/deliveries.db"
      # Shared secret for /deliver authentication. Passed from the host
      # env at compose-up time (docker compose inherits unset values
      # from the shell). Deliberately distinct from DREM_BEARER_TOKEN:
      # different audiences, never share a secret. Generate once via
      # `openssl rand -hex 32 > ~/.drem/csuite-watcher.token && chmod 600`
      # then `export CSUITE_WATCHER_TOKEN=$(cat ~/.drem/csuite-watcher.token)`.
      CSUITE_WATCHER_TOKEN:
      # Audit token path for /v1/audit/* endpoints (consumed by
      # `drem csuite audit` CLI). Points at the same shared-secret file
      # the personas bind-mount read-only below; the watcher binary
      # loads it via cmd/csuite-watcher/serve.go loadAuditToken(). Added
      # to close the 199efe2 compose-template gap — see
      # plans/csuite-watcher-audit-token-mount-gap.md.
      DREM_AUDIT_TOKEN_PATH: "/run/secrets/csuite-watcher-token"
    volumes:
      # Read-write view of the operator's shared csuite tree so the
      # watcher can route outbox files into sibling personas' inboxes.
      # The persona-side mounts (csuite-<persona> below) give each
      # persona access only to its own subtree; the watcher is the
      # single trusted router. See plans/csuite-watcher-outbox-routing.md
      # §4 bind-mount topology change.
      - {{.CsuiteHomeRoot}}:/csuite:rw
      # Watcher-private state (delivery ledger). Named volume so the
      # SQLite file survives container recreation but stays out of the
      # shared /csuite/ tree.
      - drem-{{.ProjectName}}-csuite-watcher-data:/var/lib/watcher
      # Shared audit-token file, read-only. Same host path the personas
      # bind below under /run/secrets/csuite-watcher-token — reuse keeps
      # the operator on a single-file rotation workflow. Required by
      # cmd/csuite-watcher/serve.go; missing mount → ENOENT → restart
      # loop. See plans/csuite-watcher-audit-token-mount-gap.md.
      - {{.CsuiteWatcherTokenPath}}:/run/secrets/csuite-watcher-token:ro
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.service: csuite-watcher
    depends_on: [orch]
    restart: unless-stopped

  # Each csuite-<persona> service bind-mounts two host paths read-only
  # or read-write so the containerized persona can (a) authenticate
  # against Claude via the operator's subscription credentials file —
  # NEVER an auth token or API key, per the subscription-only directive
  # in CLAUDE.md — and (b) reach the per-persona inbox/outbox/state
  # tree the operator writes to on the host. Without the .drem-csuite
  # mount, inbox messages dropped at <CsuiteHomeRoot>/<persona>/inbox/
  # never reach the container and state.md writes die at container
  # restart. Mounts land at host-identical paths inside the image's
  # /home/drem because the csuite-base Dockerfile sets WORKDIR to that.

  # Persona signal wiring (plans/csuite-watcher-outbox-routing.md §1-3
  # and commit 7b): each persona POSTs to http://csuite-watcher:8090/deliver
  # after a successful outbox write so the watcher can route the reply
  # into the addressed persona's inbox. CSUITE_WATCHER_TOKEN is passed
  # through from the host shell env at `docker compose up` time — the
  # valueless form in the template means "inherit from host env". The
  # token is shared across every persona and the watcher; operator
  # generates once via `openssl rand -hex 32 > ~/.drem/csuite-watcher.token`
  # then exports CSUITE_WATCHER_TOKEN=$(cat ~/.drem/csuite-watcher.token)
  # before `docker compose up`.

  csuite-mike:
    image: {{index .CsuiteImages "mike"}}
    environment:
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_ORCH_URL: "http://orch:8080"
      # Scoreboard item 33 mitigation: the persona binary reads
      # CSUITE_WATCHER_TOKEN_FILE when CSUITE_WATCHER_TOKEN is empty,
      # so the token-file bind-mount below is the primary path
      # (survives operator shell-env gaps between compose-ups). The
      # env-var inherit form is kept for backward-compat but should
      # be considered deprecated.
      CSUITE_WATCHER_TOKEN:
      CSUITE_WATCHER_TOKEN_FILE: "/run/secrets/csuite-watcher-token"
      CSUITE_SIGNAL_ENDPOINT: "http://csuite-watcher:8090/deliver"
      # Extend the poller's per-claude-p timeout from the 5-minute
      # default to 60 minutes so CTO-synthesis and deep-analysis tasks
      # don't hit the default ceiling. See csuite-entrypoint.sh for
      # the env-var contract.
      DREM_CLAUDE_TIMEOUT: "60m"
    volumes:
      - {{.WorkerCredsPath}}:/home/drem/.claude/.credentials.json:ro
      # Scoreboard item 33: bind-mount the csuite-watcher shared token
      # file read-only into the container. The persona binary reads
      # CSUITE_WATCHER_TOKEN_FILE (set above) when CSUITE_WATCHER_TOKEN
      # is empty, so this mount path is the canonical source of truth
      # regardless of host shell env state at `docker compose up` time.
      - {{.CsuiteWatcherTokenPath}}:/run/secrets/csuite-watcher-token:ro
      # Bind-mount the project's bare-repo master working-tree plans/
      # directory so personas can read plan docs, PRDs, and investigation
      # notes directly without delegating to a temp worker with repo
      # access. Read-only; bare-repo master working tree is the source
      # of truth. Path inside container: /home/drem/orch-plans/. Seth
      # (CTO) flagged this as a recurring wall during pass-1 / pass-2
      # synthesis passes — closing it eliminates delegation overhead on
      # every future CTO synthesis.
      - {{.BareRepoPath}}/master/plans:/home/drem/orch-plans:ro
      - {{.CsuiteHomeRoot}}/mike:/home/drem/.drem-csuite/mike:rw
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.agent_type: csuite-mike
    depends_on: [orch]
    restart: unless-stopped

  csuite-alex:
    image: {{index .CsuiteImages "alex"}}
    environment:
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_ORCH_URL: "http://orch:8080"
      # Scoreboard item 33 mitigation: the persona binary reads
      # CSUITE_WATCHER_TOKEN_FILE when CSUITE_WATCHER_TOKEN is empty,
      # so the token-file bind-mount below is the primary path
      # (survives operator shell-env gaps between compose-ups). The
      # env-var inherit form is kept for backward-compat but should
      # be considered deprecated.
      CSUITE_WATCHER_TOKEN:
      CSUITE_WATCHER_TOKEN_FILE: "/run/secrets/csuite-watcher-token"
      CSUITE_SIGNAL_ENDPOINT: "http://csuite-watcher:8090/deliver"
      # Extend the poller's per-claude-p timeout from the 5-minute
      # default to 60 minutes so CTO-synthesis and deep-analysis tasks
      # don't hit the default ceiling. See csuite-entrypoint.sh for
      # the env-var contract.
      DREM_CLAUDE_TIMEOUT: "60m"
    volumes:
      - {{.WorkerCredsPath}}:/home/drem/.claude/.credentials.json:ro
      # Scoreboard item 33: bind-mount the csuite-watcher shared token
      # file read-only into the container. The persona binary reads
      # CSUITE_WATCHER_TOKEN_FILE (set above) when CSUITE_WATCHER_TOKEN
      # is empty, so this mount path is the canonical source of truth
      # regardless of host shell env state at `docker compose up` time.
      - {{.CsuiteWatcherTokenPath}}:/run/secrets/csuite-watcher-token:ro
      # Bind-mount the project's bare-repo master working-tree plans/
      # directory so personas can read plan docs, PRDs, and investigation
      # notes directly without delegating to a temp worker with repo
      # access. Read-only; bare-repo master working tree is the source
      # of truth. Path inside container: /home/drem/orch-plans/. Seth
      # (CTO) flagged this as a recurring wall during pass-1 / pass-2
      # synthesis passes — closing it eliminates delegation overhead on
      # every future CTO synthesis.
      - {{.BareRepoPath}}/master/plans:/home/drem/orch-plans:ro
      - {{.CsuiteHomeRoot}}/alex:/home/drem/.drem-csuite/alex:rw
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.agent_type: csuite-alex
    depends_on: [orch]
    restart: unless-stopped

  csuite-seth:
    image: {{index .CsuiteImages "seth"}}
    environment:
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_ORCH_URL: "http://orch:8080"
      # Scoreboard item 33 mitigation: the persona binary reads
      # CSUITE_WATCHER_TOKEN_FILE when CSUITE_WATCHER_TOKEN is empty,
      # so the token-file bind-mount below is the primary path
      # (survives operator shell-env gaps between compose-ups). The
      # env-var inherit form is kept for backward-compat but should
      # be considered deprecated.
      CSUITE_WATCHER_TOKEN:
      CSUITE_WATCHER_TOKEN_FILE: "/run/secrets/csuite-watcher-token"
      CSUITE_SIGNAL_ENDPOINT: "http://csuite-watcher:8090/deliver"
      # Extend the poller's per-claude-p timeout from the 5-minute
      # default to 60 minutes so CTO-synthesis and deep-analysis tasks
      # don't hit the default ceiling. See csuite-entrypoint.sh for
      # the env-var contract.
      DREM_CLAUDE_TIMEOUT: "60m"
    volumes:
      - {{.WorkerCredsPath}}:/home/drem/.claude/.credentials.json:ro
      # Scoreboard item 33: bind-mount the csuite-watcher shared token
      # file read-only into the container. The persona binary reads
      # CSUITE_WATCHER_TOKEN_FILE (set above) when CSUITE_WATCHER_TOKEN
      # is empty, so this mount path is the canonical source of truth
      # regardless of host shell env state at `docker compose up` time.
      - {{.CsuiteWatcherTokenPath}}:/run/secrets/csuite-watcher-token:ro
      # Bind-mount the project's bare-repo master working-tree plans/
      # directory so personas can read plan docs, PRDs, and investigation
      # notes directly without delegating to a temp worker with repo
      # access. Read-only; bare-repo master working tree is the source
      # of truth. Path inside container: /home/drem/orch-plans/. Seth
      # (CTO) flagged this as a recurring wall during pass-1 / pass-2
      # synthesis passes — closing it eliminates delegation overhead on
      # every future CTO synthesis.
      - {{.BareRepoPath}}/master/plans:/home/drem/orch-plans:ro
      - {{.CsuiteHomeRoot}}/seth:/home/drem/.drem-csuite/seth:rw
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.agent_type: csuite-seth
    depends_on: [orch]
    restart: unless-stopped

  # csuite-kyle is the CEO persona. Runs the same csuite-persona poller
  # as mike/alex/seth but with one deliberate privilege asymmetry:
  # the orch-plans bind-mount is :rw (not :ro). Kyle is the C-Suite's
  # plan-author — he authors PRDs, plan docs, and session records under
  # plans/ in the bare-repo master working tree — so he needs to write
  # there directly rather than delegate to a worker. The other three
  # personas remain :ro; only Kyle's service block differs. See
  # plans/container-kyle-transition.md §Phase 1 (Seth adjustment #2).
  csuite-kyle:
    image: {{index .CsuiteImages "kyle"}}
    environment:
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_ORCH_URL: "http://orch:8080"
      # Scoreboard item 33 mitigation: the persona binary reads
      # CSUITE_WATCHER_TOKEN_FILE when CSUITE_WATCHER_TOKEN is empty,
      # so the token-file bind-mount below is the primary path
      # (survives operator shell-env gaps between compose-ups). The
      # env-var inherit form is kept for backward-compat but should
      # be considered deprecated.
      CSUITE_WATCHER_TOKEN:
      CSUITE_WATCHER_TOKEN_FILE: "/run/secrets/csuite-watcher-token"
      CSUITE_SIGNAL_ENDPOINT: "http://csuite-watcher:8090/deliver"
      # Extend the poller's per-claude-p timeout from the 5-minute
      # default to 60 minutes so CEO-level synthesis and deep-analysis
      # tasks don't hit the default ceiling. Same tuning as the other
      # three personas.
      DREM_CLAUDE_TIMEOUT: "60m"
    volumes:
      - {{.WorkerCredsPath}}:/home/drem/.claude/.credentials.json:ro
      # Scoreboard item 33: bind-mount the csuite-watcher shared token
      # file read-only into the container. The persona binary reads
      # CSUITE_WATCHER_TOKEN_FILE (set above) when CSUITE_WATCHER_TOKEN
      # is empty, so this mount path is the canonical source of truth
      # regardless of host shell env state at `docker compose up` time.
      - {{.CsuiteWatcherTokenPath}}:/run/secrets/csuite-watcher-token:ro
      # Kyle-only :rw on the plans tree. Every other persona's block
      # mounts this path :ro. Kyle writes plan docs during normal
      # operation — PRD drafts, container-Kyle-transition.md style
      # plan files, session records, scoreboard spin-outs — and
      # delegating every edit to a worker container would add minutes
      # of latency to every plan revision. The operator's interactive
      # Kyle instance writes to the same path on the host; the
      # coexistence rules in docs/csuite-agents/prompts/kyle.md
      # (Phase 4) spell out how the two Kyles hand off the tree.
      - {{.BareRepoPath}}/master/plans:/home/drem/orch-plans:rw
      - {{.CsuiteHomeRoot}}/kyle:/home/drem/.drem-csuite/kyle:rw
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.agent_type: csuite-kyle
    depends_on: [orch]
    restart: unless-stopped

  worker-template:
    image: {{.WorkerImage}}
    # Worker containers are spawned on demand by drem-spawner; this entry
    # exists so `docker compose pull` primes the image on first up. The
    # service does not run by default.
    profiles: ["never"]
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.agent_type: worker
      drem.language: "{{.Language}}"

  merger-template:
    image: {{.MergerImage}}
    # drem-merger is a per-task one-shot binary that requires --feature-branch,
    # --task-id, --test-cmd, --orch-url, and --agentmon-token at startup. It
    # cannot run as a long-lived warm pool — flag validation would reject the
    # empty argv and crash-loop. Spawn-on-demand wiring (orch -> spawner ->
    # short-lived merger container) is tracked in
    # plans/merger-spawn-on-demand.md. This entry exists only so
    # `docker compose pull` primes the image; the service does not run.
    profiles: ["never"]
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.agent_type: merger

