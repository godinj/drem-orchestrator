{
  "uid": "drem-cost-over-time",
  "title": "Cost Over Time",
  "description": "Agent cost tracking — cumulative and per-agent cost from the agents table and metrics table",
  "tags": ["drem", "cost"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Total Spend",
      "description": "Sum of total_cost_usd across all agents",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
          "rawSql": "SELECT SUM(total_cost_usd) AS total_spend FROM agents WHERE total_cost_usd > 0",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "title": "Agents with Cost Data",
      "description": "Count of agents that have reported cost",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
          "rawSql": "SELECT COUNT(*) AS agents_with_cost FROM agents WHERE total_cost_usd > 0",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 3,
      "title": "Average Cost per Agent",
      "description": "Mean total_cost_usd among agents with cost data",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
          "rawSql": "SELECT AVG(total_cost_usd) AS avg_cost FROM agents WHERE total_cost_usd > 0",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Max Cost Agent",
      "description": "Most expensive single agent run",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "orange", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
          "rawSql": "SELECT MAX(total_cost_usd) AS max_cost FROM agents WHERE total_cost_usd > 0",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cumulative Cost Over Time",
      "description": "Running total of cost as agents complete, ordered by completed_at",
      "type": "timeseries",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 5 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "scheme",
            "pointSize": 5,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
          "rawSql": "SELECT completed_at AS time, SUM(total_cost_usd) OVER (ORDER BY completed_at) AS cumulative_cost FROM agents WHERE total_cost_usd > 0 AND completed_at IS NOT NULL ORDER BY completed_at",
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "title": "Cost per Agent (Individual Runs)",
      "description": "Each agent's cost plotted at its completion time",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 17 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "points",
            "pointSize": 8,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
          "rawSql": "SELECT completed_at AS time, total_cost_usd AS cost, name FROM agents WHERE total_cost_usd > 0 AND completed_at IS NOT NULL ORDER BY completed_at",
          "refId": "A",
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "title": "Cost by Model",
      "description": "Total spend grouped by model_id",
      "type": "barchart",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 17 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.8
      },
      "targets": [
        {
          "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
          "rawSql": "SELECT CASE WHEN model_id = '' THEN 'unknown' ELSE model_id END AS model, SUM(total_cost_usd) AS total_cost FROM agents WHERE total_cost_usd > 0 GROUP BY model ORDER BY total_cost DESC",
          "refId": "A",
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "title": "Cost from Metrics Table (cost_usd samples)",
      "description": "Time-series cost_usd metric samples from the metrics table — populates as Phase 2 metrics collection runs",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 27 },
      "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 5,
            "showPoints": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "frser-sqlite-datasource", "uid": "drem-sqlite" },
          "rawSql": "SELECT m.timestamp AS time, a.name AS agent, m.value AS cost_usd FROM metrics m JOIN agents a ON m.agent_id = a.id WHERE m.name = 'cost_usd' ORDER BY m.timestamp",
          "refId": "A",
          "format": "time_series"
        }
      ]
    }
  ]
}
