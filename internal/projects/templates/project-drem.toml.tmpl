# Generated by `drem project register` — do not edit by hand.
# Regenerate with `drem project register --update {{.ProjectName}}`.
#
# Mounted read-only into the orch container at /var/lib/drem/drem.toml
# (the container's CWD) by project-compose.yml.tmpl. The orchestrator
# binary reads drem.toml from CWD on startup; see cmd/drem/main.go
# LoadConfig.

bare_repo_path = "{{.BareRepoPath}}"
database_path  = "/var/lib/drem/drem.db"
log_path       = "/var/lib/drem/drem.log"
{{ if .TestCommand -}}
test_command    = "{{.TestCommand}}"
{{ end -}}
{{ if .CompileCommand -}}
compile_command = "{{.CompileCommand}}"
{{ end -}}
# Compatibility for currently deployed orch images that still read the
# legacy top-level key in HTTP project metadata.
project_language = "{{.Language}}"

[project]
  language = "{{.Language}}"

[delivery]
  integration_policy  = "{{.IntegrationPolicy}}"
  verification_policy = "{{.VerificationPolicy}}"

[review_policy]
  plan  = "{{.PlanReviewPolicy}}"
  tests = "{{.TestReviewPolicy}}"

# Classifier routes through the warm drem-classifier container on drem-net.
# - `direct=true` bypasses the legacy OpenCode subprocess path (unavailable
#   inside the headless orch container; kept here so the inline-fallback
#   DirectClassifierConfig still gets built).
# - `endpoint` points orch at the warm drem-classifier service. When set,
#   orch POSTs classify jobs to this URL instead of running the LLM call
#   inline — see plans/warm-direct-classifier.md. Unset falls back to the
#   inline direct-SGLang path, which is the rollback-safe default.
# - DREM_CLASSIFIER_URL in the compose env overrides this key.
[agents.classifier]
  direct   = true
  endpoint = "http://drem-classifier:8090/classify"
  model    = "{{.InferenceModel}}"

# Endpoint override shared by direct-classifier, direct-prep, and
# direct-tool-agent. The default of http://localhost:8081 resolves to
# orch itself inside the container and therefore fails; gq on drem-net
# forwards to sglang on drem-net.
[direct_tool_agent]
  endpoint = "{{.InferenceEndpoint}}"
  model    = "{{.InferenceModel}}"
  # Qwen coding turns on a 3090 can take several minutes while actively
  # generating. Keep the HTTP deadline above the measured worst-case turn;
  # inference/token budgets remain the deterministic run-wide ceilings.
  timeout  = "10m"
  tool_arguments_format = "{{.InferenceToolArgumentsFormat}}"
  # Per-request live context. Cumulative phase budgets below may be larger
  # because they account for several folded/resumed turns.
  context_limit = 32768
  # A bounded stop with a non-empty diff is preserved for deterministic gates,
  # so long post-edit command loops no longer need a 50-turn budget.
  max_iterations = 16
  # Cumulative replay budget, distinct from the model's live context window.
  # Phase overrides give complex local coding work more room while reviews
  # remain cheap. Useful mutation checkpoints proceed to deterministic gates.
  max_cumulative_input_tokens = 60000
  test_max_cumulative_input_tokens = 90000
  implementation_max_cumulative_input_tokens = 90000
  integration_max_cumulative_input_tokens = 75000
  review_max_cumulative_input_tokens = 30000
  # Hard run-wide and pre-mutation limits stop search loops before they consume
  # the larger checkpoint-preserving phase budget.
  max_tool_calls = 20
  max_input_tokens_before_mutation = 20000
  # C++ behavioral tests commonly need the owned test TU plus several
  # production-seam reads. Stop reconnaissance at 55k so the 90k cumulative
  # budget retains ample room for a complete mutation-only response.
  test_max_input_tokens_before_mutation = 55000
  implementation_max_input_tokens_before_mutation = 30000
  integration_max_input_tokens_before_mutation = 24000
  # This compatibility-named budget counts all reconnaissance, including
  # structured search and discovery-like bash; read-only discovery is allowed
  # within this budget before the first edit.
  max_reads_before_mutation = 4
  test_max_reads_before_mutation = 8
  implementation_max_reads_before_mutation = 6
  integration_max_reads_before_mutation = 6

# Coding tasks need tool calls and bounded final answers, not hidden chain-of-
# thought. Explicitly disable optional model thinking so a short generation
# budget cannot be exhausted before the first mutation call.
[direct_tool_agent.chat_template_kwargs]
  enable_thinking = false

# Coder/reviewer/fixer work uses the GQ-fronted direct-tool path.
[agents.coder]
  provider = "sglang-direct"
  model    = "{{.InferenceModel}}"
  effort   = "medium"

[agents.reviewer]
  provider = "sglang-direct"
  model    = "{{.InferenceModel}}"
  effort   = "medium"

[agents.fixer]
  provider = "sglang-direct"
  model    = "{{.InferenceModel}}"
  effort   = "medium"

# Merger uses the same GQ-fronted model as the direct tool agents.
[agents.merger]
  provider = "sglang-direct"
  model    = "{{.InferenceModel}}"

# Planner runs as a long-lived warm drem-planner container (see
# deploy/compose/global.yml) that orch reaches via POST /plan. Provider=codex
# enables the HTTP path in processPlanning.
#
# Auth comes from the operator's Codex login: the planner container
# bind-mounts ~/.codex/auth.json from the host read-only. Operator must
# have run `codex login` on host before `docker compose up`.
[agents.planner]
  provider = "codex"
  model    = "gpt-5.4-mini"
  effort   = "high"
