# deploy/compose/.env — operator-local environment overrides for global.yml.
#
# Usage:
#   cp deploy/compose/.env.example deploy/compose/.env
#   $EDITOR deploy/compose/.env          # edit to match this host
#   docker compose -f deploy/compose/global.yml up -d
#
# Compose auto-loads deploy/compose/.env because the file sits next to the
# compose file. Variables resolve via ${NAME:-default} substitutions in
# global.yml; unset vars fall back to the documented default.
#
# The checked-in template carries the working values for a typical drem
# workstation (matches the host-side SGLang launcher the compose file is
# replacing). Override anything that differs on a new machine.
#
# The live .env is gitignored (top-level `.env` pattern in .gitignore).

# ---------- SGLang ----------
#
# SGLANG_MODEL_DIR
#   Absolute path on the host holding model weight subdirectories. Bind-
#   mounted read-only into the container at /models. Must contain a
#   subdirectory named ${SGLANG_MODEL_SUBDIR}.
#   Default: $HOME/sglang-models
#
SGLANG_MODEL_DIR=/home/godinj/models

# SGLANG_MODEL_SUBDIR
#   Relative path under /models inside the container pointing at the weights
#   directory. Becomes the --model-path argument to sglang.launch_server.
#   For a typical Hugging Face download this is the full repo-id-style dir
#   name (e.g. `gemma-4-26B-A4B-it-AWQ-4bit-textonly`), not a friendly alias.
#   Default: gemma4-26b
#
SGLANG_MODEL_SUBDIR=gemma-4-26B-A4B-it-AWQ-4bit-textonly

# SGLANG_SERVED_NAME
#   Name the container advertises over the OpenAI-compatible API. Drem
#   clients reference this name in drem.toml ([agents.classifier].model,
#   [direct_tool_agent].model, etc.) so it must match whatever the clients
#   already expect. Change both sides together or nothing dispatches.
#   Default: gemma4-26b
#
SGLANG_SERVED_NAME=gemma4-26b

# SGLANG_CONTEXT_LENGTH
#   Maximum prompt+completion token count the server will accept. Drem's
#   planner and reviewer prompts approach 100k on large repos; the host
#   launcher ran 131072.
#   Default: 131072
#
SGLANG_CONTEXT_LENGTH=131072

# SGLANG_MEM_FRACTION
#   Fraction of GPU VRAM reserved for the KV cache + activations. Higher
#   values allow more concurrent requests but risk OOM on other workloads.
#   Default: 0.85
#
SGLANG_MEM_FRACTION=0.85

# SGLANG_MAX_REQUESTS
#   Max concurrent requests served before the scheduler queues. Aligns with
#   gq's `max_slots` to avoid head-of-line blocking upstream.
#   Default: 4
#
SGLANG_MAX_REQUESTS=4

# SGLANG_TP
#   Tensor-parallel degree. Set to the number of GPUs to shard across.
#   Single-GPU hosts leave this at 1.
#   Default: 1
#
SGLANG_TP=1
