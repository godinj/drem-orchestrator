# Generated by `drem project register` — do not edit by hand.
# Regenerate with `drem project register --update {{.ProjectName}}`.

version: "3.9"

networks:
  drem-net:
    external: true

volumes:
  drem-{{.ProjectName}}-db:
  drem-{{.ProjectName}}-prompts:
  # csuite-watcher private state (delivery ledger). Named volume keeps
  # watcher-internal SQLite out of the shared /csuite/ tree so a
  # mis-aimed persona write can never corrupt the idempotency key.
  # See plans/csuite-watcher-outbox-routing.md §4.
  drem-{{.ProjectName}}-csuite-watcher-data:
  drem-spawner-sock:
    external: true
    name: drem-spawner-sock

services:
  orch:
    image: {{.OrchImage}}
    environment:
      DREM_HEADLESS: "1"
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_BARE_REPO: "{{.BareRepoPath}}"
      DREM_DB_PATH: "/var/lib/drem/drem.db"
      DREM_ORCH_LISTEN: ":8080"
      DREM_SPAWNER_SOCKET: "/var/run/drem/spawner.sock"
      # Self-URL so dispatchMerge can pass --orch-url to spawned merger
      # containers. Mergers POST merge_result records back to this URL.
      DREM_ORCH_URL: "http://orch:8080"
      DREM_AGENTMON_TOKEN: "{{.SharedToken}}"
      # Warm drem-classifier endpoint — orch POSTs classify jobs here
      # instead of running the direct-SGLang call inline. Matches the
      # endpoint also declared in drem.toml [agents.classifier]; this env
      # var wins when both are set. See plans/warm-direct-classifier.md.
      DREM_CLASSIFIER_URL: "http://drem-classifier:8090/classify"
      # Warm drem-planner endpoint — orch POSTs plan jobs here instead of
      # spawning per-task planner containers. The planner container
      # bind-mounts the operator's Claude subscription credentials and
      # shells out to the claude CLI per request. See
      # plans/warm-planner-pivot.md §§2-4. Subscription-only auth (no
      # API-key env passthrough anywhere in this generated compose).
      DREM_PLANNER_URL: "http://drem-planner:8090/plan"
      # Host path of the operator's Claude subscription credentials
      # file. Orch forwards this into every claude-backed worker spawn
      # as SpawnWorkerParams.CredsMount; the spawner bind-mounts it
      # read-only at /home/drem/.claude/.credentials.json inside the
      # worker. Subscription-only auth — no API-key fallback. See
      # plans/worker-subscription-auth.md §§1, 6.
      DREM_WORKER_CREDS_PATH: "{{.WorkerCredsPath}}"
      # Host directory where orch atomically writes per-task prompt
      # files. The spawner (a separate container) later bind-mounts the
      # individual file read-only into each worker at
      # /home/drem/.drem/prompt.md. The path is host-identical on orch
      # (bind-mount below) so os.WriteFile in orch and os.Stat in
      # spawner see the same bytes. See
      # plans/worker-prompt-delivery.md §§2, 4.
      DREM_PROMPT_ROOT_HOST: "{{.WorkerPromptRoot}}"
    volumes:
      - drem-{{.ProjectName}}-db:/var/lib/drem
      - drem-{{.ProjectName}}-prompts:/var/lib/drem/prompts
      # Bind-mount the bare repo at its HOST-identical path so DREM_BARE_REPO
      # (which is a host path) resolves inside the container. Mounting at a
      # different target ("/bare") broke `git worktree list` because the repo
      # env var and the mount target disagreed.
      - {{.BareRepoPath}}:{{.BareRepoPath}}:rw
      # Worker prompt root, bind-mounted read-write at its HOST-identical
      # path so orch can write per-task prompt files and the spawner's
      # (separate-container) pre-stat sees the same path orch wrote to.
      # Read-write: orch writes, spawner only reads. See
      # plans/worker-prompt-delivery.md §4.
      - {{.WorkerPromptRoot}}:{{.WorkerPromptRoot}}:rw
      # drem.toml is generated alongside this compose file and mounted into
      # the orch CWD so LoadConfig finds it. Enables direct-classifier and
      # points the direct-tool endpoint at gq on drem-net. Path is absolute
      # because docker compose does not expand ~.
      - {{.ConfigFilePath}}:/var/lib/drem/drem.toml:ro
      - drem-spawner-sock:/var/run/drem:ro{{if .DevMode}}
      - {{.RepoSourcePath}}:/src:ro{{end}}
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.service: orch
    ports:
      - "127.0.0.1:{{.OrchHostPort}}:8080"
    restart: unless-stopped

  agentmon:
    image: localhost:5000/drem-agentmon:latest
    environment:
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_ORCH_URL: "http://orch:8080"
      DREM_AGENTMON_TOKEN: "{{.SharedToken}}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.service: agentmon
    depends_on: [orch]
    restart: unless-stopped

  csuite-watcher:
    image: localhost:5000/drem-csuite-watcher:latest
    environment:
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_ORCH_URL: "http://orch:8080"
      # 12-factor overrides for cmd/csuite-watcher serve. The container has
      # no drem.toml mounted; the binary reads these instead of [serve] keys.
      # Reuses the agentmon shared token so both can authenticate against orch.
      DREM_BEARER_TOKEN: "{{.SharedToken}}"
      DREM_LISTEN_ADDR: ":8090"
      DREM_DB_PATH: "/var/lib/drem/csuite.db"
      # Outbox-routing delivery ledger — SQLite stored under the named
      # volume mounted at /var/lib/watcher below. See
      # plans/csuite-watcher-outbox-routing.md §Failure modes.
      CSUITE_WATCHER_DB_PATH: "/var/lib/watcher/deliveries.db"
      # Shared secret for /deliver authentication. Passed from the host
      # env at compose-up time (docker compose inherits unset values
      # from the shell). Deliberately distinct from DREM_BEARER_TOKEN:
      # different audiences, never share a secret. Generate once via
      # `openssl rand -hex 32 > ~/.drem/csuite-watcher.token && chmod 600`
      # then `export CSUITE_WATCHER_TOKEN=$(cat ~/.drem/csuite-watcher.token)`.
      CSUITE_WATCHER_TOKEN:
    volumes:
      # Read-write view of the operator's shared csuite tree so the
      # watcher can route outbox files into sibling personas' inboxes.
      # The persona-side mounts (csuite-<persona> below) give each
      # persona access only to its own subtree; the watcher is the
      # single trusted router. See plans/csuite-watcher-outbox-routing.md
      # §4 bind-mount topology change.
      - {{.CsuiteHomeRoot}}:/csuite:rw
      # Watcher-private state (delivery ledger). Named volume so the
      # SQLite file survives container recreation but stays out of the
      # shared /csuite/ tree.
      - drem-{{.ProjectName}}-csuite-watcher-data:/var/lib/watcher
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.service: csuite-watcher
    depends_on: [orch]
    restart: unless-stopped

  # Each csuite-<persona> service bind-mounts two host paths read-only
  # or read-write so the containerized persona can (a) authenticate
  # against Claude via the operator's subscription credentials file —
  # NEVER an auth token or API key, per the subscription-only directive
  # in CLAUDE.md — and (b) reach the per-persona inbox/outbox/state
  # tree the operator writes to on the host. Without the .drem-csuite
  # mount, inbox messages dropped at <CsuiteHomeRoot>/<persona>/inbox/
  # never reach the container and state.md writes die at container
  # restart. Mounts land at host-identical paths inside the image's
  # /home/drem because the csuite-base Dockerfile sets WORKDIR to that.

  csuite-mike:
    image: {{index .CsuiteImages "mike"}}
    environment:
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_ORCH_URL: "http://orch:8080"
    volumes:
      - {{.WorkerCredsPath}}:/home/drem/.claude/.credentials.json:ro
      - {{.CsuiteHomeRoot}}/mike:/home/drem/.drem-csuite/mike:rw
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.agent_type: csuite-mike
    depends_on: [orch]
    restart: unless-stopped

  csuite-alex:
    image: {{index .CsuiteImages "alex"}}
    environment:
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_ORCH_URL: "http://orch:8080"
    volumes:
      - {{.WorkerCredsPath}}:/home/drem/.claude/.credentials.json:ro
      - {{.CsuiteHomeRoot}}/alex:/home/drem/.drem-csuite/alex:rw
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.agent_type: csuite-alex
    depends_on: [orch]
    restart: unless-stopped

  csuite-ross:
    image: {{index .CsuiteImages "ross"}}
    environment:
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_ORCH_URL: "http://orch:8080"
    volumes:
      - {{.WorkerCredsPath}}:/home/drem/.claude/.credentials.json:ro
      - {{.CsuiteHomeRoot}}/ross:/home/drem/.drem-csuite/ross:rw
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.agent_type: csuite-ross
    depends_on: [orch]
    restart: unless-stopped

  csuite-seth:
    image: {{index .CsuiteImages "seth"}}
    environment:
      DREM_PROJECT: "{{.ProjectName}}"
      DREM_ORCH_URL: "http://orch:8080"
    volumes:
      - {{.WorkerCredsPath}}:/home/drem/.claude/.credentials.json:ro
      - {{.CsuiteHomeRoot}}/seth:/home/drem/.drem-csuite/seth:rw
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.agent_type: csuite-seth
    depends_on: [orch]
    restart: unless-stopped

  worker-template:
    image: {{.WorkerImage}}
    # Worker containers are spawned on demand by drem-spawner; this entry
    # exists so `docker compose pull` primes the image on first up. The
    # service does not run by default.
    profiles: ["never"]
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.agent_type: worker
      drem.language: "{{.Language}}"

  merger-template:
    image: {{.MergerImage}}
    # drem-merger is a per-task one-shot binary that requires --feature-branch,
    # --task-id, --test-cmd, --orch-url, and --agentmon-token at startup. It
    # cannot run as a long-lived warm pool — flag validation would reject the
    # empty argv and crash-loop. Spawn-on-demand wiring (orch -> spawner ->
    # short-lived merger container) is tracked in
    # plans/merger-spawn-on-demand.md. This entry exists only so
    # `docker compose pull` primes the image; the service does not run.
    profiles: ["never"]
    networks: [drem-net]
    labels:
      drem.project: "{{.ProjectName}}"
      drem.agent_type: merger

